<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patientview.api.model">
    <class name="FollowUp" table="patientview_follow_up">
        <id name="id" type="int" column="follow_up_id">
            <generator class="native"/>
        </id>
        <property name="uuid" type="string" column="uuid" length="38" unique="true"/>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="true"/>
        <property name="consultationDate" type="date" column="consultation_date"/>
        <property name="clinicalExam" type="string" column="clinical_exam" length="1000"/>
        <property name="neurologicalExam" type="string" column="neurological_exam" length="1000"/>
        <property name="controlImaging" type="string" column="control_imaging" length="1000"/>
        <property name="recurrence" type="boolean" column="recurrence"/>
        <property name="currentTreatment" type="string" column="current_treatment" length="500"/>
        <property name="nextConsultationDate" type="date" column="next_consultation_date"/>
        <property name="notes" type="string" column="notes" length="1000"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator" not-null="true"/>
        <property name="dateCreated" type="timestamp" column="date_created" not-null="true"/>
    </class>
</hibernate-mapping>
