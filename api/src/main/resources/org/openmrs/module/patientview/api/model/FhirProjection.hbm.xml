<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patientview.api.model">
    <class name="FhirProjection" table="patientview_fhir_projection">
        <id name="id" type="int" column="fhir_projection_id">
            <generator class="native"/>
        </id>
        <property name="uuid" type="string" column="uuid" length="38" unique="true"/>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="true"/>
        <property name="sourceSet" type="string" column="source_set" length="100" not-null="true"/>
        <property name="sourceUuid" type="string" column="source_uuid" length="38" not-null="true"/>
        <property name="encounterUuid" type="string" column="encounter_uuid" length="38" not-null="true"/>
        <property name="manifestFingerprint" type="string" column="manifest_fingerprint" length="64"/>
        <property name="dateCreated" type="timestamp" column="date_created" not-null="true"/>
    </class>
</hibernate-mapping>
