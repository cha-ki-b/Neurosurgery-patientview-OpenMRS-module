<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patientview.api.model">
    <class name="SurgicalTreatment" table="patientview_surgical_treatment">
        <id name="id" type="int" column="surgical_treatment_id">
            <generator class="native"/>
        </id>
        <property name="uuid" type="string" column="uuid" length="38" unique="true"/>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="true"/>
        <property name="procedurePerformed" type="string" column="procedure_performed" length="255"/>
        <property name="resectionType" type="string" column="resection_type" length="50"/>
        <property name="surgeryDate" type="date" column="surgery_date"/>
        <property name="durationMinutes" type="int" column="duration_minutes"/>
        <property name="surgeon" type="string" column="surgeon" length="255"/>
        <property name="intraoperativeComplications" type="string" column="intraoperative_complications" length="1000"/>
        <property name="drainPlaced" type="boolean" column="drain_placed"/>
        <property name="catheterPlaced" type="boolean" column="catheter_placed"/>
        <property name="notes" type="string" column="notes" length="1000"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator" not-null="true"/>
        <property name="dateCreated" type="timestamp" column="date_created" not-null="true"/>
    </class>
</hibernate-mapping>
