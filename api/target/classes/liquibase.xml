    <changeSet id="patientview-2026-07-19-01" author="patientview-roadmap">
        <comment>Creating the patientview_neuro_assessment table</comment>
        <createTable tableName="patientview_neuro_assessment">
            <column name="neuro_assessment_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="patient_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="assessment_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="eye_response" type="int"/>
            <column name="verbal_response" type="int"/>
            <column name="motor_response" type="int"/>
            <column name="gcs_total" type="int"/>
            <column name="notes" type="varchar(1000)"/>
            <column name="creator" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="patientview_neuro_patient_fk"
            baseTableName="patientview_neuro_assessment" baseColumnNames="patient_id"
            referencedTableName="patient" referencedColumnNames="patient_id"/>
        <addForeignKeyConstraint constraintName="patientview_neuro_creator_fk"
            baseTableName="patientview_neuro_assessment" baseColumnNames="creator"
            referencedTableName="users" referencedColumnNames="user_id"/>
    </changeSet>

    <changeSet id="patientview-2026-07-19-02" author="patientview-roadmap">
        <comment>Creating the patientview_surgical_history table</comment>
        <createTable tableName="patientview_surgical_history">
            <column name="surgical_history_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="patient_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="procedure_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date_performed" type="datetime"/>
            <column name="surgeon" type="varchar(255)"/>
            <column name="outcome" type="varchar(255)"/>
            <column name="notes" type="varchar(1000)"/>
            <column name="creator" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="patientview_surg_patient_fk"
            baseTableName="patientview_surgical_history" baseColumnNames="patient_id"
            referencedTableName="patient" referencedColumnNames="patient_id"/>
        <addForeignKeyConstraint constraintName="patientview_surg_creator_fk"
            baseTableName="patientview_surgical_history" baseColumnNames="creator"
            referencedTableName="users" referencedColumnNames="user_id"/>
    </changeSet>

