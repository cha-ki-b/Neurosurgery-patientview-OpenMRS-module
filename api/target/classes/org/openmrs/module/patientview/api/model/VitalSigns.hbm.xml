<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patientview.api.model">
    <class name="VitalSigns" table="patientview_vital_signs">
        <id name="id" type="int" column="vital_signs_id">
            <generator class="native"/>
        </id>
        <property name="uuid" type="string" column="uuid" length="38" unique="true"/>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="true"/>
        <property name="examDate" type="timestamp" column="exam_date" not-null="true"/>
        <property name="temperature" type="big_decimal" column="temperature"/>
        <property name="bpSystolic" type="int" column="bp_systolic"/>
        <property name="bpDiastolic" type="int" column="bp_diastolic"/>
        <property name="heartRate" type="int" column="heart_rate"/>
        <property name="respiratoryRate" type="int" column="respiratory_rate"/>
        <property name="spo2" type="int" column="spo2"/>
        <property name="weightKg" type="big_decimal" column="weight_kg"/>
        <property name="heightCm" type="big_decimal" column="height_cm"/>
        <property name="bmi" type="big_decimal" column="bmi"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator" not-null="true"/>
        <property name="dateCreated" type="timestamp" column="date_created" not-null="true"/>
    </class>
</hibernate-mapping>
