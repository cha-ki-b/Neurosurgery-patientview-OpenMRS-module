<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patientview.api.model">
    <class name="PostopEvolution" table="patientview_postop_evolution">
        <id name="id" type="int" column="postop_evolution_id">
            <generator class="native"/>
        </id>
        <property name="uuid" type="string" column="uuid" length="38" unique="true"/>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="true"/>
        <property name="postopGcs" type="int" column="postop_gcs"/>
        <property name="postopKarnofsky" type="int" column="postop_karnofsky"/>
        <property name="neurologicalStatus" type="string" column="neurological_status" length="255"/>
        <property name="infection" type="boolean" column="infection"/>
        <property name="hemorrhage" type="boolean" column="hemorrhage"/>
        <property name="hydrocephalus" type="boolean" column="hydrocephalus"/>
        <property name="csfLeak" type="boolean" column="csf_leak"/>
        <property name="seizures" type="boolean" column="seizures"/>
        <property name="deceased" type="boolean" column="deceased"/>
        <property name="deathDate" type="date" column="death_date"/>
        <property name="notes" type="string" column="notes" length="1000"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator" not-null="true"/>
        <property name="dateCreated" type="timestamp" column="date_created" not-null="true"/>
    </class>
</hibernate-mapping>
