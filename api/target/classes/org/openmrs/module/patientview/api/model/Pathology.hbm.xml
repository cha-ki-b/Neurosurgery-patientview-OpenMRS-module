<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patientview.api.model">
    <class name="Pathology" table="patientview_pathology">
        <id name="id" type="int" column="pathology_id">
            <generator class="native"/>
        </id>
        <property name="uuid" type="string" column="uuid" length="38" unique="true"/>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="true"/>
        <property name="studyFindings" type="string" column="study_findings" length="1000"/>
        <property name="whoGrade" type="string" column="who_grade" length="50"/>
        <property name="immunohistochemistry" type="string" column="immunohistochemistry" length="1000"/>
        <property name="molecularMarkers" type="string" column="molecular_markers" length="1000"/>
        <property name="finalDiagnosis" type="string" column="final_diagnosis" length="500"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator" not-null="true"/>
        <property name="dateCreated" type="timestamp" column="date_created" not-null="true"/>
    </class>
</hibernate-mapping>
