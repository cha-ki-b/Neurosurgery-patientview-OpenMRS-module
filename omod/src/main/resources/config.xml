<?xml version="1.0" encoding="UTF-8"?>
<module configVersion="1.2">
    
    <!-- Basic Module Properties -->
    <id>patientview</id>
    <name>Neurosurgery Patient View Override</name>
    <version>1.4.1</version>
    <package>org.openmrs.module.patientview</package>
    <author>Hani</author>
    <description>
        Simple override of the patient view for neurosurgery departments.
        Replaces the default coreapps patient page with a neurosurgery-focused view.
    </description>
    
    <activator>org.openmrs.module.patientview.PatientViewActivator</activator>
    
    <!-- OpenMRS Version Requirements -->
    <require_version>2.4.3</require_version>
    
    <!-- Required Modules -->
    <require_modules>
        <require_module version="2.16.0">
            org.openmrs.module.uiframework
        </require_module>
        <require_module version="2.24.0">
            org.openmrs.module.webservices.rest
        </require_module>
        <require_module version="1.16.0">
            org.openmrs.module.coreapps
        </require_module>
        <require_module version="1.10.0">
            org.openmrs.module.appui
        </require_module>
    </require_modules>

    <!-- Optional companion module. The Imagerie tab reads this patient's DICOM studies from
         `imaging` when it is installed (see DicomStudyBridge for why it is read reflectively
         rather than depended on). Declared here instead of as a Maven dependency so patientview
         still starts, and that tab still shows its own comptes rendus, when imaging is absent;
         aware_of_module additionally guarantees imaging is started first, so its classes are
         resolvable by the time a page asks for them. -->
    <aware_of_modules>
        <aware_of_module>org.openmrs.module.imaging</aware_of_module>
    </aware_of_modules>

    <!-- Hibernate mapping files for this module's persistent classes -->
    <mappingFiles>
        org/openmrs/module/patientview/api/model/NeuroAssessment.hbm.xml
        org/openmrs/module/patientview/api/model/SurgicalHistory.hbm.xml
        org/openmrs/module/patientview/api/model/MedicalHistory.hbm.xml
        org/openmrs/module/patientview/api/model/AdmissionContext.hbm.xml
        org/openmrs/module/patientview/api/model/VitalSigns.hbm.xml
        org/openmrs/module/patientview/api/model/NeuroExamDetail.hbm.xml
        org/openmrs/module/patientview/api/model/NeurosurgicalDiagnosis.hbm.xml
        org/openmrs/module/patientview/api/model/Pathology.hbm.xml
        org/openmrs/module/patientview/api/model/MedicalTreatment.hbm.xml
        org/openmrs/module/patientview/api/model/SurgicalTreatment.hbm.xml
        org/openmrs/module/patientview/api/model/PostopEvolution.hbm.xml
        org/openmrs/module/patientview/api/model/Sequelae.hbm.xml
        org/openmrs/module/patientview/api/model/LabResult.hbm.xml
        org/openmrs/module/patientview/api/model/Discharge.hbm.xml
        org/openmrs/module/patientview/api/model/FollowUp.hbm.xml
        org/openmrs/module/patientview/api/model/ImagingNote.hbm.xml
        org/openmrs/module/patientview/api/model/FhirProjection.hbm.xml
    </mappingFiles>

    <!-- Required Privileges -->
    <privilege>
        <name>View Neurosurgery Data</name>
        <description>Able to view neurosurgery patient-view records (antecedents, exams, diagnosis, pathology, etc.)</description>
    </privilege>
    <privilege>
        <name>Manage Neurosurgery Data</name>
        <description>Able to create and update neurosurgery patient-view records</description>
    </privilege>
    <privilege>
        <name>App: patientview.neurosurgeryDashboard</name>
        <description>Able to see and open the Neurosurgery Dashboard (read-only access) - assign to nurses</description>
    </privilege>
    <privilege>
        <name>App: patientview.neurosurgeryDashboard.manage</name>
        <description>Able to add and edit neurosurgery patient-view records from the dashboard - assign to surgeons and radiologists (in addition to the view privilege above)</description>
    </privilege>
    <!-- /Required Privileges -->

    <!-- Messages -->
    <messages>
        <lang>en</lang>
        <file>messages.properties</file>
    </messages>
    
</module>