# Copy this file to ".env" (same folder) and replace every value below with a strong,
# randomly generated secret. Never commit the real ".env" file - it is already excluded
# via .gitignore.
#
# Generate a strong random value for each, e.g.: openssl rand -base64 24

MYSQL_ROOT_PASSWORD=change-me-generate-a-strong-random-value
MYSQL_USER=openmrs
MYSQL_PASSWORD=change-me-generate-a-strong-random-value
MYSQL_DB=openmrs

ORTHANC_DB_PASSWORD=change-me-generate-a-strong-random-value
ORTHANC_ADMIN_PASSWORD=change-me-generate-a-strong-random-value
